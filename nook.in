#!@SHELL@
# Copyright (C) 2011-2015 Richard "RichiH" Hartmann <richih@debian.org>, see CONTRIBUTORS for details.
# SPDX-License-Identifier: GPL-2.0-or-later
#
# While the following is not legally binding, the author would like to explain
# the choice of GPLv2+ over GPLv3+. The author prefers GPLv3+ over GPLv2+ but
# feels it's better to maintain full compatibility's with Git. In case Git ever
# changes its licensing terms, which is admittedly extremely unlikely to the
# point of being impossible, this software will most likely follow suit.

# This should always be the first line of code to facilitate debugging
[ -n "$NOOK_DEBUG" ] && set -vx

# If '.r<N>-g<SHA>' is appended to the version, you are seeing an unreleased
# version built from the main branch HEAD. If "-standalone" is appended you are
# using a version built explicitly for portability as a standalone script
# rather than being installed to a specific system.
NOOK_VERSION='@VERSION@@DEPLOYMENT@'; export NOOK_VERSION
NOOK_SELF='nook'; export NOOK_SELF

# Ensure all files created are accessible only to the current user.
umask 0077

fatal() {
	echo "$NOOK_SELF: fatal: $1" >&2
	[ -z "$2" ] && exit 1
	exit "$2"
}

# We need to run getops as soon as possible so we catch -d and other
# options that will modify our behaviour.
# Commands are handled at the end of this script.
# shellcheck disable=SC2220
while getopts c:dv flag; do
	case "$flag" in
		d)
			set -vx
			NOOK_DEBUG=1
			export NOOK_DEBUG
			echo 'debug mode on'
			echo "$NOOK_SELF $NOOK_VERSION"
			;;
		v)
			NOOK_VERBOSE=1
			export NOOK_VERBOSE
			echo 'verbose mode on'
			echo "$NOOK_SELF $NOOK_VERSION"
			;;
		c)
			NOOK_OPTION_CONFIG="$OPTARG"
			export NOOK_OPTION_CONFIG
			;;
	esac
done
shift $((OPTIND-1))

source_all() {
	# Source file even if it's in $PWD and does not have any slashes in it
	# shellcheck source=/dev/null
	case "$1" in
		*/*) . "$1";;
		*)   . "$PWD/$1";;
	esac;
}


# Read configuration and set defaults if anything's not set
[ -n "$NOOK_DEBUG" ]                  && set -vx
: "${XDG_CONFIG_HOME:="$HOME/.config"}"

# Read configuration files if there are any
# shellcheck source=/dev/null
[ -r "/etc/nook/nookrc" ]            && . "/etc/nook/nookrc"
# shellcheck source=/dev/null
[ -r "$XDG_CONFIG_HOME/nook/.nookrc" ] && . "$XDG_CONFIG_HOME/nook/.nookrc"
if [ -n "$NOOK_OPTION_CONFIG" ]; then
	# Source $NOOK_OPTION_CONFIG if it can be read and is in $PWD of $PATH
	if [ -r "$NOOK_OPTION_CONFIG" ]; then
		source_all "$NOOK_OPTION_CONFIG"
	else
		fatal "Can not read configuration file '$NOOK_OPTION_CONFIG'" 1
	fi
fi
[ -n "$NOOK_DEBUG" ]                  && set -vx

# Read defaults
: "${NOOK_REPO_D:="$XDG_CONFIG_HOME/nook"}"; export NOOK_REPO_D
: "${NOOK_HOOK_D:="$XDG_CONFIG_HOME/nook/hooks"}"; export NOOK_HOOK_D
: "${NOOK_OVERLAY_D:="$XDG_CONFIG_HOME/nook/overlays"}"; export NOOK_OVERLAY_D
: "${NOOK_REPOS:="$XDG_CONFIG_HOME/nook/.repos"}"; export NOOK_REPOS
: "${NOOK_BASE:="$HOME"}"; export NOOK_BASE
: "${NOOK_GITIGNORE:=exact}"; export NOOK_GITIGNORE
: "${NOOK_GITATTRIBUTES:=none}"; export NOOK_GITATTRIBUTES
: "${NOOK_WORKTREE:=absolute}"; export NOOK_WORKTREE
: "${NOOK_SHOW_UNTRACKED:=no}"; export NOOK_SHOW_UNTRACKED
: "${NOOK_GITCONFIG:="$XDG_CONFIG_HOME/nook/.gitconfig"}"; export NOOK_GITCONFIG
: "${NOOK_GITIGNORE_FILE:="$XDG_CONFIG_HOME/nook/.gitignore"}"; export NOOK_GITIGNORE_FILE
: "${NOOK_GITATTRIBUTES_FILE:="$XDG_CONFIG_HOME/nook/.gitattributes"}"; export NOOK_GITATTRIBUTES_FILE

if [ ! "x$NOOK_GITIGNORE" = 'xexact' ] && [ ! "x$NOOK_GITIGNORE" = 'xnone' ] && [ ! "x$NOOK_GITIGNORE" = 'xrecursive' ]; then
	fatal "'\$NOOK_GITIGNORE' must equal 'exact', 'none', or 'recursive'" 1
fi

if [ ! "x$NOOK_WORKTREE" = 'xabsolute' ] && [ ! "x$NOOK_WORKTREE" = 'xrelative' ]; then
	fatal "'\$NOOK_WORKTREE' must equal 'absolute', or 'relative'" 1
fi


# editorconfig-checker-disable
help() {
	echo "usage: $NOOK_SELF <options> <command>

   options:
   -c <file>            Source file
   -d                   Enable debug mode
   -v                   Enable verbose mode

   commands:
   add <repo> [<tags>]  Add <repo>'s line to \$NOOK_REPOS; <tags> is an
                        optional comma-separated list (4th column)
   add --all | -a       Append every local repo with a remote not already
                        in \$NOOK_REPOS (written without tags)
   clone [-b <branch>] \\
         <remote> \\
         [<repo>]       Clone from an existing repository
   commit               Commit in all repositories
   config \\
     [<git config args>] Edit shared git config included by every repo
                        (\$NOOK_GITCONFIG); no args lists it
   delete <repo>        Delete an existing repository
   enter <repo>         Enter repository; spawn new instance of \$SHELL
                        with \$GIT_DIR set.
   foreach \\
     [<-g>] [<-p>] \\
     <git command>      Execute a command for every repository
   help                 Display this help text
   init <repo>          Initialize a new repository
   list                 List all repositories
   list-tracked \\
        [<repo>]        List all files tracked all or one repositories
   list-untracked \\
        [<-a>] [<-r>]
        [<repo>]        List all files not tracked by all or one repositories
   pull                 Pull from all nook remotes
   push                 Push to nook remotes
   bootstrap \\
     [--include=<tags>] \\
     [--exclude=<tags>] \\
     [@<tags>] \\
     [<file>]           Clone every repo in \$NOOK_REPOS (populate it with
                        'add') not already present. With --include (or a bare
                        '@tag' / '@a,b' positional), only rows whose 4th-column
                        tags match (untagged rows always match); --exclude
                        drops rows with a matching tag. A leading '@' on any
                        tag is optional. Also: 'clone --all|-a [same opts]'
                        and 'clone @<tags> [same opts]'.
   rename <repo> \\
          <newname>     Rename repository
   run <repo> \\
       <command>        Use this repository
   status \\
     [--terse] [<repo>] Show statuses of all/one nook repositories
   upgrade <repo>       Upgrade repository to currently recommended settings
   version              Print version information
   which <substring>    Find substring in name of any tracked file
   write-gitignore \\
   [<repo>]             Write <repo>.nook/.gitignore via git ls-files

   <repo> <git command> Shortcut to run git commands directly
   <repo>               Shortcut to enter repository" >&2
}
# editorconfig-checker-enable

debug() {
	if [ -n "$NOOK_DEBUG" ]; then echo "$NOOK_SELF: debug: $*"; fi
}

verbose() {
	if [ -n "$NOOK_DEBUG" ] || [ -n "$NOOK_VERBOSE" ]; then
		echo "$NOOK_SELF: verbose: $*"
	fi
}

error() {
	echo "$NOOK_SELF: error: $1" >&2
}

info() {
	echo "$NOOK_SELF: info: $1"
}

clone() {
	hook pre-clone
	# Check if remote is reachable. Abort early if there's a typo, TLS certificate problem, etc
	@GIT@ ls-remote "$GIT_REMOTE" 2> /dev/null || fatal "Can not reach '$GIT_REMOTE'"
	init
	# Test which, if any, given or detected branches can be pulled from.
	# In a future version, if we need the logic, we could do the following:
	#   git ls-remote ORIGIN
	#   get HEAD commit ID
	#   see what refs/heads/* match that commit ID
	#   set NOOK_BRANCH if only one match
	#   offer a list of all matching refs for the user to choose
	for NOOK_BRANCH_TEST in "$NOOK_BRANCH" master trunk development; do
		if [ $(@GIT@ ls-remote "$GIT_REMOTE" "$NOOK_BRANCH_TEST" 2> /dev/null | @WC@ -l ) -lt 1 ]; then
			info "remote branch '$NOOK_BRANCH_TEST' empty"
		else
			info "remote branch '$NOOK_BRANCH_TEST' found"
			NOOK_BRANCH_REMOTE=$NOOK_BRANCH_TEST
			break
		fi
	done
	if [ -z "$NOOK_BRANCH_REMOTE" ]; then
		info "No non-empty remote branches found, aborting. Please run `$0 delete $NOOK_REPO_NAME`, determine the correct branch, and try again."
		exit
	fi
	NOOK_BRANCH=$NOOK_BRANCH_REMOTE

	# Set up remote
	@GIT@ remote add origin "$GIT_REMOTE"
	@GIT@ checkout -b "$NOOK_BRANCH" || return $?
	@GIT@ config branch."$NOOK_BRANCH".remote origin
	@GIT@ config branch."$NOOK_BRANCH".merge  refs/heads/"$NOOK_BRANCH"
	GIT_VERSION_MAJOR=$(@GIT@ --version | @SED@ -E -n 's/.* ([0-9]+)\..*/\1/p' )
	if [ 1 -lt "$GIT_VERSION_MAJOR" ];then
		@GIT@ fetch origin "$NOOK_BRANCH"
	else
		@GIT@ fetch origin
	fi
	hook pre-merge
	@GIT@ read-tree -n -mu origin/"$NOOK_BRANCH" \
		|| fatal "will stop after fetching and not try to merge!
  Once this situation has been resolved, run 'nook $NOOK_REPO_NAME pull' to finish cloning." 17 # editorconfig-checker-disable-line
	@GIT@ -c merge.ff=true merge origin/"$NOOK_BRANCH"
	hook post-merge
	hook post-clone
	retire
	hook post-clone-retired
}

commit() {
	hook_global pre-commit
	shift  # remove the "commit" command.
	for NOOK_REPO_NAME in $(list); do
		export NOOK_REPO_NAME
		echo "$NOOK_REPO_NAME: "
		GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-commit
		@GIT@ commit --untracked-files=no --quiet "$@"
		hook_repo post-commit
		NOOK_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-commit
}

delete() {
	cd "$NOOK_BASE" || fatal "could not enter '$NOOK_BASE'" 11
	use
	info "This operation WILL DESTROY DATA!"
	files=$(@GIT@ ls-files)
	echo "These files will be deleted:

$files

AGAIN, THIS WILL DELETE YOUR DATA!
To continue, type 'Yes, do as I say'"
	read -r answer
	[ "x$answer" = 'xYes, do as I say' ] || exit 16
	# Use -z/-0 so that paths containing whitespace, shell globbing
	# characters, or non-ASCII bytes (which `git ls-files` would otherwise
	# C-quote) are handled verbatim; `--` guards against leading dashes.
	@GIT@ ls-files -z | xargs -0 rm -f -- ||
		info "could not delete some files, continuing with repository deletion"
	# Remove the whole <name>.nook/ container (git dir, per-repo config,
	# per-repo gitignore/gitattributes).
	rm -rf "${GIT_DIR%/*}" || error "could not delete '${GIT_DIR%/*}'"
}

enter() {
	hook pre-enter
	use
	$SHELL
	hook post-enter
}

foreach() {
	hook_global pre-foreach

	# We default to prefixing `git` to all commands passed to foreach, but
	# allow running in general context with -g
	command_prefix=@GIT@
	# shellcheck disable=SC2220
	while getopts gp flag; do
		case "$flag" in
			g) unset command_prefix ;;
			p) NOOK_PRINT_REPO_PREFIX=1 ;;
		esac
	done
	shift $((OPTIND-1))
	export NOOK_PRINT_REPO_PREFIX
	for NOOK_REPO_NAME in $(list); do
		export NOOK_REPO_NAME
		GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-foreach
		if [ -n "${NOOK_PRINT_REPO_PREFIX+x}" ]; then
			$command_prefix "$@" | @SED@ "s/^/$NOOK_REPO_NAME: /"
		else
			echo "$NOOK_REPO_NAME:"
			$command_prefix "$@"
		fi
		hook_repo post-foreach
	done
	hook_global post-foreach
}

git_dir_exists() {
	[ -d "$GIT_DIR" ] || fatal "no repository found for '$NOOK_REPO_NAME'" 12
}

hook_global() {
	for hook in "$NOOK_HOOK_D/$1"*; do
		[ -x "$hook" ] || continue
		verbose "executing '$hook'"
		"$hook"
	done
}

hook_repo() {
	for hook in "$NOOK_HOOK_D/$NOOK_REPO_NAME.$1"*; do
		[ -x "$hook" ] || continue
		verbose "executing '$hook'"
		"$hook" || fatal "hook [$hook] failed" 1
	done
}

hook() {
	hook_global "$1"
	hook_repo "$1"
}

init() {
	hook pre-init
	[ ! -e "$GIT_DIR" ] || fatal "'$GIT_DIR' exists" 10
	mkdir -p "$NOOK_BASE" || fatal "could not create '$NOOK_BASE'" 50
	mkdir -p "${GIT_DIR%/*}" || fatal "could not create '${GIT_DIR%/*}'" 50
	cd "$NOOK_BASE" || fatal "could not enter '$NOOK_BASE'" 11
	@GIT@ init --shared=false
	upgrade
	hook post-init
}

list() {
	for repo in "$NOOK_REPO_D"/*.nook; do
		[ -d "$repo" ] || continue
		name=$(basename "$repo" .nook)
		[ -d "$repo/$name.git" ] && [ -r "$repo/$name.git" ] && echo "$name"
	done
}

list_has_remote() {
	for NOOK_REPO_NAME in $(list); do
		GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
		# This command returns the tracking branch of the currently-checked-out local
		# branch, if any. See https://stackoverflow.com/a/9753364
		[ -n  "$(@GIT@ for-each-ref "$(@GIT@ symbolic-ref -q HEAD)")" ] && echo "$NOOK_REPO_NAME"
	done
}

config() {
	# Read/write $NOOK_GITCONFIG, a git config file that every nook repo
	# includes (wired up by upgrade()). Args are passed straight to
	# `git config`, e.g.  nook config credential.helper '!gh auth git-credential'
	# With no args, list the current contents.
	shift
	[ -e "$NOOK_GITCONFIG" ] || : > "$NOOK_GITCONFIG" ||
		fatal "could not create '$NOOK_GITCONFIG'" 50
	[ "$#" -eq 0 ] && set -- --list
	# Run from / so a stray/broken .git in the cwd's ancestry (e.g. a
	# leftover gitlink in $HOME) cannot make repo discovery fail here.
	@GIT@ -C / config --file "$NOOK_GITCONFIG" "$@"
	NOOK_COMMAND_RETURN_CODE=$?
}

repos_has() {
	# True if $NOOK_REPOS has a non-comment line for repo name $1.
	local _n _rest
	[ -r "$NOOK_REPOS" ] || return 1
	while read -r _n _rest || [ -n "$_n" ]; do
		case "$_n" in ''|\#*) continue;; esac
		[ "x$_n" = "x$1" ] && return 0
	done < "$NOOK_REPOS"
	return 1
}

repos_line() {
	# Print "<name> <url> <branch> @tags," for repo $1 ($2 = optional tag list).
	# Tags are always emitted with a leading '@' and a trailing ',' so the
	# column is unambiguous; a leading '@' or trailing ',' in $2 is absorbed.
	# Return 1 if the repo has no origin URL.
	local url branch tags
	GIT_DIR=$NOOK_REPO_D/$1.nook/$1.git; export GIT_DIR
	url=$(@GIT@ config --get remote.origin.url 2> /dev/null) || return 1
	[ -n "$url" ] || return 1
	branch=$(@GIT@ symbolic-ref --quiet --short HEAD 2> /dev/null) || branch=
	tags=${2#@}; tags=${tags%,}
	printf '%s %s %s%s\n' "$1" "$url" "$branch" "${tags:+ @$tags,}"
}

repos_append() {
	# Append "$1" (a repos_line string) to $NOOK_REPOS, creating it with a
	# header if needed.
	[ -e "$NOOK_REPOS" ] || echo "# nook repos -- <name> <url> <branch> @tags,   (tags optional)" > "$NOOK_REPOS" ||
		fatal "add: could not create '$NOOK_REPOS'" 50
	printf '%s\n' "$1" >> "$NOOK_REPOS" || fatal "add: could not write '$NOOK_REPOS'" 50
}

add() {
	shift  # drop the "add" command word
	case ${1:-} in
		--all|-a)
			local n line
			n=0
			for NOOK_REPO_NAME in $(list); do
				repos_has "$NOOK_REPO_NAME" && continue
				line=$(repos_line "$NOOK_REPO_NAME") || continue
				repos_append "$line"
				info "added '$NOOK_REPO_NAME'"
				n=$((n + 1))
			done
			info "$n repo(s) appended to '$NOOK_REPOS'"
			;;
		'')
			fatal "add: specify a repository name, or --all / -a" 1
			;;
		*)
			local line tags
			[ -d "$NOOK_REPO_D/$1.nook/$1.git" ] || fatal "add: no such repository: '$1'" 12
			if repos_has "$1"; then
				info "'$1' is already in '$NOOK_REPOS'"
				return 0
			fi
			line=$(repos_line "$1" "${2:-}") || fatal "add: '$1' has no 'origin' remote" 1
			repos_append "$line"
			tags=${2#@}; tags=${tags%,}
			info "added '$1' to '$NOOK_REPOS'${tags:+ (tags: @$tags,)}"
			;;
	esac
}

tag_match() {
	# $1 = a line's tags (comma list, may be empty)
	# $2 = --include tags (comma list, may be empty)
	# $3 = --exclude tags (comma list, may be empty)
	# Returns 0 if the line should be cloned.
	#   - an untagged row always matches (it is "universal")
	#   - a tagged row is opt-in: it matches only if one of its tags was
	#     passed via --include; a bare `bootstrap` (no --include) skips it
	#   - --exclude always wins
	# All three inputs are normalised the same way: lower-cased, split on
	# ',', and a leading '@' on any tag is dropped -- so `--include=@laptop`
	# and `--include=laptop` behave identically.
	local lt inc exc t x i
	lt=$(printf '%s' "$1" | tr 'A-Z,@' 'a-z  ')
	inc=$(printf '%s' "$2" | tr 'A-Z,@' 'a-z  ')
	exc=$(printf '%s' "$3" | tr 'A-Z,@' 'a-z  ')
	# exclude wins
	for x in $exc; do
		for t in $lt; do [ "$t" = "$x" ] && return 1; done
	done
	# untagged (universal) row -> always keep
	[ -z "$lt" ] && return 0
	# tagged row -> keep only if one of its tags is in --include
	for i in $inc; do
		for t in $lt; do [ "$t" = "$i" ] && return 0; done
	done
	return 1
}

bootstrap() {
	# Clone every repo listed in $NOOK_REPOS that is not already present.
	# Reached as `nook bootstrap [opts] [<file>]` or
	# `nook clone --all|-a [opts] [<file>]`.
	# opts: --include=tag,tag  --exclude=tag,tag  @tag[,tag]
	# A bare "@tag" (or "@a,b") positional is shorthand for --include=tag;
	# repeated --include/--exclude/@tag args accumulate.
	shift  # drop the command word
	local inc exc source_file a
	inc= exc= source_file=$NOOK_REPOS
	for a in "$@"; do
		case $a in
			--include=*) inc="${inc:+$inc,}${a#--include=}" ;;
			--exclude=*) exc="${exc:+$exc,}${a#--exclude=}" ;;
			--include|--exclude) fatal "bootstrap: use $a=tag,tag" 1 ;;
			@*) inc="${inc:+$inc,}$a" ;;
			-*) fatal "bootstrap: unknown option '$a'" 1 ;;
			*) source_file=$a ;;
		esac
	done
	[ -r "$source_file" ] || fatal "$NOOK_COMMAND: repos file not readable: '$source_file'" 1
	# Fields are whitespace-separated; none of name/url/branch can contain a space.
	while read -r name url branch tags || [ -n "$name" ]; do
		tags=${tags#@}
		case "$name" in ''|\#*) continue;; esac
		if [ -z "$url" ]; then
			info "skipping '$name': no URL in repos file"
			continue
		fi
		if ! tag_match "$tags" "$inc" "$exc"; then
			verbose "skipping '$name': tags '${tags:-none}' do not match filter"
			continue
		fi
		if [ -e "$NOOK_REPO_D/$name.nook/$name.git" ]; then
			info "skipping '$name': already present"
			continue
		fi
		info "cloning '$name' from '$url'"
		if [ -n "$branch" ]; then
			"$0" clone -b "$branch" "$url" "$name" || error "failed to clone '$name'"
		else
			"$0" clone "$url" "$name" || error "failed to clone '$name'"
		fi
	done < "$source_file"
}

get_files() {
	GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
	@GIT@ ls-files --full-name
}

list_tracked() {
	NOOK_REPO_NAME=$2; export NOOK_REPO_NAME
	if [ -n "$NOOK_REPO_NAME" ]; then
		get_files | list_tracked_helper
	else
		for NOOK_REPO_NAME in $(list); do
			get_files
		done | list_tracked_helper
	fi
}

list_tracked_helper() {
	@SED@ "s,^,$(printf '%s\n' "$NOOK_BASE/" | @SED@ 's/[,\&]/\\&/g')," | sort -u
}

list_tracked_by() {
	list_tracked '' "$2"
}

list_untracked() {
	temp_file_others=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'
	temp_file_untracked=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'
	temp_file_untracked_copy=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'

	# Hack in support for `nook list-untracked -r`...
	exclude_standard_opt='--exclude-standard'
	directory_opt='--directory'
	shift
	while getopts ar flag; do
		case "$flag" in
			a) unset exclude_standard_opt ;;
			r) unset directory_opt ;;
		esac
	done
	shift $((OPTIND-1))
	# ...and parse for a potential parameter afterwards. As we shifted things out of $* in during getops, we need to look at $1
	NOOK_REPO_NAME=$1; export NOOK_REPO_NAME

	if [ -n "$NOOK_REPO_NAME" ]; then
		list_untracked_helper "$NOOK_REPO_NAME"
	else
		for NOOK_REPO_NAME in $(list); do
			list_untracked_helper "$NOOK_REPO_NAME"
		done
	fi
	cat "$temp_file_untracked"

	unset directory_opt directory_component
	rm -f "$temp_file_others" "$temp_file_untracked" "$temp_file_untracked_copy" || fatal 'Could not delete temp files'
}

list_untracked_helper() {
	export GIT_DIR="$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git"
	@GIT@ ls-files --others $exclude_standard_opt $directory_opt | (
		while read -r line; do
			echo "$line"
			directory_component=${line%%/*}
			[ -d "$directory_component" ] && printf '%s/\n' "$directory_component"
		done
		) | sort -u > "$temp_file_others"
	if [ -z "$ran_once" ]; then
		ran_once=1
		cp "$temp_file_others" "$temp_file_untracked" || fatal 'Could not copy temp file'
	fi
	cp "$temp_file_untracked" "$temp_file_untracked_copy" || fatal 'Could not copy temp file'
	@COMM@ -12 "$temp_file_others" "$temp_file_untracked_copy" > "$temp_file_untracked"
}

pull() {
	hook_global pre-pull
	for NOOK_REPO_NAME in $(list_has_remote); do
		export NOOK_REPO_NAME
		printf '%s: ' "$NOOK_REPO_NAME"
		GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-pull
		@GIT@ pull
		hook_repo post-pull
		NOOK_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-pull
}

push() {
	hook_global pre-push
	for NOOK_REPO_NAME in $(list_has_remote); do
		export NOOK_REPO_NAME
		printf '%s: ' "$NOOK_REPO_NAME"
		GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-push
		@GIT@ push
		hook_repo post-push
		NOOK_COMMAND_RETURN_CODE=$?
		echo
	done
	hook_global post-push
}

retire() {
	unset NOOK_DIRECTORY
}

rename() {
	git_dir_exists
	nook_dir_old=${GIT_DIR%/*}
	nook_dir_new=${GIT_DIR_NEW%/*}
	[ -e "$nook_dir_new" ] && fatal "'$nook_dir_new' exists" 54
	# Move the whole <name>.nook/ container, then rename the git dir inside it.
	mv -f "$nook_dir_old" "$nook_dir_new" ||
		fatal "Could not mv '$nook_dir_old' '$nook_dir_new'" 52
	mv -f "$nook_dir_new/$NOOK_REPO_NAME.git" "$GIT_DIR_NEW" ||
		fatal "Could not rename git dir to '$GIT_DIR_NEW'" 52

	# Now that the repository has been renamed, we need to fix up its configuration
	# Overwrite old name..
	GIT_DIR=$GIT_DIR_NEW
	NOOK_REPO_NAME=$NOOK_REPO_NAME_NEW
	# ..and clobber all old configuration
	upgrade
}

run() {
	hook pre-run
	use
	"$@"
	NOOK_COMMAND_RETURN_CODE=$?
	hook post-run
}

# Smart implicit -f for `nook <repo> add ...`.
#
# nook's fallback ignore file is a single `*`, so every deliberate `add` of a
# path would otherwise need `-f`. This transparently supplies it -- but ONLY
# when the catch-all `*` is the sole thing in the way. If any named pathspec
# is matched by a more specific pattern (a hand-written rule in a per-repo
# .gitignore, .git/info/exclude, ...) we stay out of the way and let git's
# normal "use -f" refusal happen, so a deliberate ignore is never bypassed.
#
# Also skipped for bulk forms (. -A --all -u --update -n --dry-run ...), when
# -f/--force is already present, or when NOOK_ADD_FORCE=no. $@ is the git
# words starting with "add"; GIT_DIR must already be exported. Prints nothing;
# returns 0 if `-f` should be injected.
auto_add_force() {
	[ x"${NOOK_ADD_FORCE:-}" = x'no' ] && return 1
	# shellcheck disable=SC2039,SC3043
	local a ddash forced skip blanket deliberate pat
	ddash=0; forced=0; skip=0; blanket=0; deliberate=0
	for a in "$@"; do
		[ "$ddash" = 1 ] && continue
		case $a in
			add) ;;
			--) ddash=1 ;;
			.|-A|--all|--no-ignore-removal|-u|--update|-n|--dry-run|--refresh|--pathspec-from-file|--pathspec-from-file=*|--pathspec-file-nul|-i|--interactive)
				skip=1 ;;
			-f|--force) forced=1 ;;
			--*) ;;
			-*) case $a in *f*) forced=1 ;; esac ;;
			*) ;;
		esac
	done
	{ [ "$skip" = 1 ] || [ "$forced" = 1 ]; } && return 1
	ddash=0
	for a in "$@"; do
		[ x"$a" = x'add' ] && continue
		if [ "$ddash" = 0 ]; then
			case $a in
				--) ddash=1; continue ;;
				-*) continue ;;
			esac
		fi
		# `check-ignore -v` prints the last matching line even when it is a
		# negation (path NOT ignored), so treat a leading '!' as "not ignored".
		pat=$(printf '%s\0' "$a" | @GIT@ check-ignore -v -z --stdin 2> /dev/null | tr '\0' '\n' | @SED@ -n '3p')
		case $pat in
			''|'!'*) ;;
			'*') blanket=1 ;;
			*) deliberate=1 ;;
		esac
	done
	[ "$deliberate" = 0 ] && [ "$blanket" = 1 ]
}

status() {
	if [ -t 1 ]; then
		COLORING="-c color.status=always"
	fi
	if [ -n "$NOOK_REPO_NAME" ]; then
		status_helper "$NOOK_REPO_NAME"
	else
		for NOOK_REPO_NAME in $(list); do
			STATUS="$(status_helper "$NOOK_REPO_NAME" "$COLORING")"
			[ -n "$STATUS" ] || [ -z "$NOOK_STATUS_TERSE" ] && echo "$NOOK_REPO_NAME:"
			[ -n "$STATUS" ]            && echo "$STATUS"
			[ -z "$NOOK_STATUS_TERSE" ] && echo
		done
	fi
}

# Warning: disabled quoting check here due to all of them relating to
#          wc -l  output and a deliberate lack of quoting for git args.
# shellcheck disable=SC2086
status_helper() {
	GIT_DIR=$NOOK_REPO_D/$1.nook/$1.git; export GIT_DIR
	NOOK_GIT_OPTIONS="-c status.relativePaths=false $2"
	use
	# Shellcheck isn't understanding a complex block.
	# shellcheck disable=SC1083
	remote_tracking_branch=$(@GIT@ rev-parse --abbrev-ref --symbolic-full-name @{u} 2> /dev/null) && {
		commits_behind=$(@GIT@ log ..${remote_tracking_branch} --oneline | @WC@ -l)
		commits_ahead=$(@GIT@ log ${remote_tracking_branch}.. --oneline | @WC@ -l)
		[ ${commits_behind} -ne 0 ] && echo "Behind $remote_tracking_branch by $commits_behind commits"
		[ ${commits_ahead} -ne 0 ] && echo "Ahead of $remote_tracking_branch by $commits_ahead commits"
	}
	@GIT@ ${NOOK_GIT_OPTIONS} status --short --untracked-files='no' | @SED@ -E 's@([^ ] +)@\1~/@'
	NOOK_COMMAND_RETURN_CODE=$?
}

upgrade() {
	hook pre-upgrade
	# fake-bare repositories are not bare, actually. Set this to false
	# because otherwise Git complains "fatal: core.bare and core.worktree
	# do not make sense"
	@GIT@ config core.bare false
	# core.worktree may be absolute or relative to $GIT_DIR, depending on
	# user preference
	if [ ! "x$NOOK_WORKTREE" = 'xabsolute' ]; then
		@GIT@ config core.worktree "$(cd "$GIT_DIR" && GIT_WORK_TREE=$NOOK_BASE @GIT@ rev-parse --show-cdup)"
	elif [ ! "x$NOOK_WORKTREE" = 'xrelative' ]; then
		@GIT@ config core.worktree "$NOOK_BASE"
	fi
	# Per-repo exclude/attributes file lives in <name>.nook/ next to the
	# git dir; if absent, fall back to the shared file in $XDG_CONFIG_HOME/nook.
	if [ ! "x$NOOK_GITIGNORE" = 'xnone' ]; then
		if [ -e "${GIT_DIR%/*}/.gitignore" ]; then
			@GIT@ config core.excludesfile "${GIT_DIR%/*}/.gitignore"
		else
			@GIT@ config core.excludesfile "$NOOK_GITIGNORE_FILE"
		fi
	fi
	if [ ! "x$NOOK_GITATTRIBUTES" = 'xnone' ]; then
		if [ -e "${GIT_DIR%/*}/.gitattributes" ]; then
			@GIT@ config core.attributesfile "${GIT_DIR%/*}/.gitattributes"
		else
			@GIT@ config core.attributesfile "$NOOK_GITATTRIBUTES_FILE"
		fi
	fi
	@GIT@ config nook.nook 'true'
	# Hide the rest of $HOME from `git status` in this repo. Override with
	# NOOK_SHOW_UNTRACKED=normal (or per repo: nook <repo> config
	# status.showUntrackedFiles normal).
	@GIT@ config status.showUntrackedFiles "$NOOK_SHOW_UNTRACKED"
	# Pull in shared settings (credential.helper, user.*, ...) that apply to
	# every nook repo. Edit that file with `nook config ...`.
	@GIT@ config --replace-all include.path "$NOOK_GITCONFIG"
	use
	hook post-upgrade
}

use() {
	git_dir_exists
	NOOK_DIRECTORY=$NOOK_REPO_NAME; export NOOK_DIRECTORY
}

which() {
	# It's ok to modify NOOK_REPO_NAME in a subshell.
	# shellcheck disable=SC2030
	output=$(for NOOK_REPO_NAME in $(list); do
		get_files | @GREP@ -- "$NOOK_COMMAND_PARAMETER" | @SED@ "s/^/$NOOK_REPO_NAME: /"
	done | sort -u)
	if [ -z "$output" ]; then
		fatal "'$NOOK_COMMAND_PARAMETER' does not exist" 1
	else
		echo "$output"
	fi
}

# Ignore warnings about NOOK_REPO_NAME being changed in a subshell.
# shellcheck disable=SC2031
write_gitignore() {
	# Don't do anything if the user does not want to write gitignore
	if [ "x$NOOK_GITIGNORE" = 'xnone' ]; then
		info "Not writing gitignore as '\$NOOK_GITIGNORE' is set to 'none'"
		exit
	fi

	use
	cd "$NOOK_BASE" || fatal "could not enter '$NOOK_BASE'" 11
	# Works in all shells we care about.
	# shellcheck disable=SC2039,SC3043
	local GIT_VERSION GIT_VERSION_MAJOR GIT_VERSION_MINOR
	GIT_VERSION="$(@GIT@ --version)"
	GIT_VERSION_MAJOR="$(echo "$GIT_VERSION" | @SED@ -E -n 's/.* ([0-9]+)\..*/\1/p')"
	GIT_VERSION_MINOR="$(echo "$GIT_VERSION" | @SED@ -E -n 's/.* ([0-9]+)\.([0-9]+)\..*/\2/p')"
	OLDIFS=$IFS
	IFS=$(printf '\n\t')
	gitignores=$(for file in $(@GIT@ ls-files); do
		while true; do
			echo "$file"; new=${file%/*}
			[ x"$file" = x"$new" ] && break
			file=$new
		done;
	done | sort -u)

	# Contrary to GNU mktemp, mktemp on BSD/OSX requires a template for temp files
	# Using a template makes GNU mktemp default to $PWD and not #TMPDIR for tempfile location
	# To make every OS happy, set full path explicitly
	local tempfile
	tempfile=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") ||
		fatal "could not create tempfile: '${tempfile}'" 51

	echo '*' > "$tempfile" || fatal "could not write to '$tempfile'" 57
	for gitignore in $gitignores; do
		echo "$gitignore" | @SED@ 's@^@!/@' >> "$tempfile" ||
			fatal "could not write to '$tempfile'" 57
		if [ "x$NOOK_GITIGNORE" = 'xrecursive' ] && [ -d "$gitignore" ]; then
			{ echo "$gitignore/*" | @SED@ 's@^@!/@' >> "$tempfile" ||
				fatal "could not write to '$tempfile'" 57; }
		fi
	done
	IFS=$OLDIFS
	local GIT_IGNORE_PATH
	GIT_IGNORE_PATH="${GIT_DIR%/*}/.gitignore"
	if diff -N "$tempfile" "$GIT_IGNORE_PATH" > /dev/null; then
		info "'$GIT_IGNORE_PATH' already up to date"
		rm -f "$tempfile" || fatal "could not delete '$tempfile'" 59
		return
	fi
	if [ -e "$GIT_IGNORE_PATH" ]; then
		info "'$GIT_IGNORE_PATH' differs from new data, moving it to '$GIT_IGNORE_PATH.bak'"
		mv -f "$GIT_IGNORE_PATH" "$GIT_IGNORE_PATH.bak" ||
			fatal "could not move '$GIT_IGNORE_PATH' to '$GIT_IGNORE_PATH.bak'" 53
	fi
	mv -f "$tempfile" "$GIT_IGNORE_PATH" ||
		fatal "could not move '$tempfile' to '$GIT_IGNORE_PATH'" 53
}

debug "$(@GIT@ version)"

if [ ! "x$NOOK_GITIGNORE" = 'xexact' ] && [ ! "x$NOOK_GITIGNORE" = 'xnone' ] && [ ! "x$NOOK_GITIGNORE" = 'xrecursive' ]; then
	fatal "'\$NOOK_GITIGNORE' must equal 'exact', 'none', or 'recursive'" 1
fi

NOOK_COMMAND=$1; export NOOK_COMMAND

case $NOOK_COMMAND in
	clon|clo|cl) NOOK_COMMAND=clone;;
	commi|comm|com|co|ci) NOOK_COMMAND=commit;;
	confi|conf|con) NOOK_COMMAND=config;;
	delet|dele|del|de) NOOK_COMMAND=delete;;
	ente|ent|en) NOOK_COMMAND=enter;;
	hel|he) NOOK_COMMAND=help;;
	ini|in) NOOK_COMMAND=init;;
	pul) NOOK_COMMAND=pull;;
	pus) NOOK_COMMAND=push;;
	renam|rena|ren|re) NOOK_COMMAND=rename;;
	ru) NOOK_COMMAND=run;;
	statu|stat|sta|st) NOOK_COMMAND=status;;
	upgrad|upgra|upgr|up) NOOK_COMMAND=upgrade;;
	versio|versi|vers|ver|ve) NOOK_COMMAND=version;;
	which|whi|wh) NOOK_COMMAND=which;;
	write|writ|wri|wr) NOOK_COMMAND=write-gitignore;;
	bootstra|bootstr|bootst|boots|boot) NOOK_COMMAND=bootstrap;;
esac

# `nook clone --all|-a [opts]` and `nook clone @tag[,tag] [opts]` are aliases
# for `nook bootstrap [opts]`.
if [ x"$NOOK_COMMAND" = x'clone' ] && { [ x"$2" = 'x--all' ] || [ x"$2" = 'x-a' ]; }; then
	NOOK_COMMAND=bootstrap
	shift 2                 # drop "clone" and "--all"/"-a"
	set -- bootstrap "$@"   # leaves $2 as the optional <file>
elif [ x"$NOOK_COMMAND" = x'clone' ]; then
	case ${2:-} in
		@*)
			NOOK_COMMAND=bootstrap
			shift              # drop "clone"; keep "@tag" and any opts
			set -- bootstrap "$@"
			;;
	esac
fi

if [ x"$NOOK_COMMAND" = x'clone' ]; then
	NOOK_BRANCH=
	if [ "$2" = -b ]; then
		NOOK_BRANCH=$3
		shift
		shift
	fi
	[ -z "$2" ] && fatal "$NOOK_COMMAND: please specify a remote" 1
	GIT_REMOTE="$2"
	[ -n "$NOOK_BRANCH" ] || if [ "$3" = -b ]; then
		NOOK_BRANCH=$4
		shift
		shift
	fi
	if [ -n "$3" ]; then
		NOOK_REPO_NAME=$3
		[ -z "$NOOK_BRANCH" ] && [ "$4" = -b ] && NOOK_BRANCH=$5
	else
		NOOK_REPO_NAME=$(basename "${GIT_REMOTE#*:}" .git)
	fi
	[ -z "$NOOK_REPO_NAME" ] && fatal "$NOOK_COMMAND: could not determine repository name" 1
	export NOOK_REPO_NAME
	[ -n "$NOOK_BRANCH" ] || NOOK_BRANCH=main
	GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
elif [ "$NOOK_COMMAND" = 'help' ]; then
	help && exit
elif [ "$NOOK_COMMAND" = 'version' ]; then
	echo "$NOOK_SELF $NOOK_VERSION"
	@GIT@ version
	exit
elif [ x"$NOOK_COMMAND" = x'which' ]; then
	[ -z "$2" ] && fatal "$NOOK_COMMAND: please specify a filename" 1
	[ -n "$3" ] && fatal "$NOOK_COMMAND: too many parameters" 1
	NOOK_COMMAND_PARAMETER=$2; export NOOK_COMMAND_PARAMETER
elif [ x"$NOOK_COMMAND" = x'delete' ]           ||
	[ x"$NOOK_COMMAND" = x'enter' ]            ||
	[ x"$NOOK_COMMAND" = x'init' ]             ||
	[ x"$NOOK_COMMAND" = x'list-tracked-by' ]  ||
	[ x"$NOOK_COMMAND" = x'rename' ]           ||
	[ x"$NOOK_COMMAND" = x'run' ]              ||
	[ x"$NOOK_COMMAND" = x'upgrade' ]          ||
	[ x"$NOOK_COMMAND" = x'write-gitignore' ]; then
	if [ -z "$2" ]; then
		[ -z "$NOOK_REPO_NAME" ] && fatal "$NOOK_COMMAND: please specify repository to work on" 1
	else
		NOOK_REPO_NAME=$2; export NOOK_REPO_NAME
	fi
	GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
	[ x"$NOOK_COMMAND" = x'rename' ] && [ -z "$3" ] && fatal "$NOOK_COMMAND: please specify a target name" 1
	[ x"$NOOK_COMMAND" = x'run'    ] && [ -z "$3" ] && fatal "$NOOK_COMMAND: please specify a command" 1
	[ x"$NOOK_COMMAND" = x'rename' ] && { NOOK_REPO_NAME_NEW=$3; export NOOK_REPO_NAME_NEW;
	GIT_DIR_NEW=$NOOK_REPO_D/$NOOK_REPO_NAME_NEW.nook/$NOOK_REPO_NAME_NEW.git; export GIT_DIR_NEW; }
	[ x"$NOOK_COMMAND" = x'run' ]    && shift 2
elif [ x"$NOOK_COMMAND" = x'foreach' ]; then
	[ -z "$2" ] && fatal "$NOOK_COMMAND: please specify a command" 1
	shift 1
elif [ x"$NOOK_COMMAND" = x'add' ] ||
	[ x"$NOOK_COMMAND" = x'commit' ] ||
	[ x"$NOOK_COMMAND" = x'config' ] ||
	[ x"$NOOK_COMMAND" = x'list'   ] ||
	[ x"$NOOK_COMMAND" = x'list-tracked' ] ||
	[ x"$NOOK_COMMAND" = x'list-untracked' ] ||
	[ x"$NOOK_COMMAND" = x'bootstrap' ] ||
	[ x"$NOOK_COMMAND" = x'pull'   ] ||
	[ x"$NOOK_COMMAND" = x'push'   ]; then
	:
elif [ x"$NOOK_COMMAND" = x'status' ]; then
	if [ x"$2" = x'--terse' ]; then
		NOOK_STATUS_TERSE=1; export NOOK_STATUS_TERSE
		shift
	fi
	NOOK_REPO_NAME=$2; export NOOK_REPO_NAME
elif [ -n "$2" ]; then
	NOOK_COMMAND='run'; export NOOK_COMMAND
	NOOK_REPO_NAME=$1; export NOOK_REPO_NAME
	GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
	[ -d "$GIT_DIR" ] || { help; exit 1; }
	shift 1
	if [ x"$1" = x'add' ] && auto_add_force "$@"; then
		shift                     # drop "add"
		set -- add -f "$@"        # ...and put it back with -f
	fi
	set -- "@GIT@" "$@"
elif [ -n "$NOOK_COMMAND" ]; then
	NOOK_COMMAND='enter'; export NOOK_COMMAND
	NOOK_REPO_NAME=$1; export NOOK_REPO_NAME
	GIT_DIR=$NOOK_REPO_D/$NOOK_REPO_NAME.nook/$NOOK_REPO_NAME.git; export GIT_DIR
	[ -d "$GIT_DIR" ] || { help; exit 1; }
else
	# $1 is empty
	help && exit 1
fi

# Did we receive a directory instead of a name?
# Mangle the input to fit normal operation.
if echo "$NOOK_REPO_NAME" | @GREP@ -q '/'; then
	GIT_DIR=$NOOK_REPO_NAME; export GIT_DIR
	NOOK_REPO_NAME=$(basename "$NOOK_REPO_NAME" .git); export NOOK_REPO_NAME
fi

check_dir() {
	check_directory="$1"
	if [ ! -d "$check_directory" ]; then
		if [ -e "$check_directory" ]; then
			fatal "'$check_directory' exists but is not a directory" 13
		else
			verbose "attempting to create '$check_directory'"
			mkdir -p "$check_directory" || fatal "could not create '$check_directory'" 50
		fi
	fi
}

check_dir "$NOOK_REPO_D"

# Seed the shared fallback ignore file so `git add .` in a nook repo is safe
# out of the box (its working tree is all of $HOME). Ignore everything; use
# `nook <repo> add -f <path>` to track a new file, or `nook write-gitignore
# <repo>` for a curated per-repo list.
if [ ! "x$NOOK_GITIGNORE" = 'xnone' ] && [ ! -e "$NOOK_GITIGNORE_FILE" ]; then
	printf '# nook: ignore everything by default; `nook <repo> add -f <path>` to track a file\n*\n' \
		> "$NOOK_GITIGNORE_FILE" 2> /dev/null || true
fi

verbose "$NOOK_COMMAND begin"
NOOK_COMMAND=$(echo "$NOOK_COMMAND" | @SED@ 's/-/_/g'); export NOOK_COMMAND

# Source repo-specific rc file, if present: <repo>.nook/.nookrc
# shellcheck source=/dev/null
[ -r "$NOOK_REPO_D/$NOOK_REPO_NAME.nook/.nookrc" ] \
	&& . "$NOOK_REPO_D/$NOOK_REPO_NAME.nook/.nookrc"

# source overlay functions
for overlay in "$NOOK_OVERLAY_D/$NOOK_COMMAND"* "$NOOK_OVERLAY_D/$NOOK_REPO_NAME.$NOOK_COMMAND"*; do
	[ -r "$overlay" ] || continue
	info "sourcing '$overlay'"
	# shellcheck source=/dev/null
	. "$overlay"
done

hook pre-command
$NOOK_COMMAND "$@"
hook post-command

verbose "$NOOK_COMMAND end, exiting"
exit $NOOK_COMMAND_RETURN_CODE

# Local Variables:
# mode:shell-script
# sh-shell:sh
# End:
# vim: ft=sh:

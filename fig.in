#!@SHELL@
# Copyright (C) 2011-2015 Richard "RichiH" Hartmann <richih@debian.org>, see CONTRIBUTORS for details.
# SPDX-License-Identifier: GPL-2.0-or-later
#
# While the following is not legally binding, the author would like to explain
# the choice of GPLv2+ over GPLv3+. The author prefers GPLv3+ over GPLv2+ but
# feels it's better to maintain full compatibility's with Git. In case Git ever
# changes its licensing terms, which is admittedly extremely unlikely to the
# point of being impossible, this software will most likely follow suit.

# This should always be the first line of code to facilitate debugging
[ -n "$FIG_DEBUG" ] && set -vx

# If '.r<N>-g<SHA>' is appended to the version, you are seeing an unreleased
# version built from the main branch HEAD. If "-standalone" is appended you are
# using a version built explicitly for portability as a standalone script
# rather than being installed to a specific system.
FIG_VERSION='@VERSION@@DEPLOYMENT@'; export FIG_VERSION
FIG_SELF='fig'; export FIG_SELF

# Ensure all files created are accessible only to the current user.
umask 0077

fatal() {
	echo "$FIG_SELF: fatal: $1" >&2
	[ -z "$2" ] && exit 1
	exit "$2"
}

# We need to run getops as soon as possible so we catch -d and other
# options that will modify our behaviour.
# Commands are handled at the end of this script.
# shellcheck disable=SC2220
while getopts c:dv flag; do
	case "$flag" in
		d)
			set -vx
			FIG_DEBUG=1
			export FIG_DEBUG
			echo 'debug mode on'
			echo "$FIG_SELF $FIG_VERSION"
			;;
		v)
			FIG_VERBOSE=1
			export FIG_VERBOSE
			echo 'verbose mode on'
			echo "$FIG_SELF $FIG_VERSION"
			;;
		c)
			FIG_OPTION_CONFIG="$OPTARG"
			export FIG_OPTION_CONFIG
			;;
	esac
done
shift $((OPTIND-1))

source_all() {
	# Source file even if it's in $PWD and does not have any slashes in it
	# shellcheck source=/dev/null
	case "$1" in
		*/*) . "$1";;
		*)   . "$PWD/$1";;
	esac;
}


# Read configuration and set defaults if anything's not set
[ -n "$FIG_DEBUG" ]                  && set -vx
: "${XDG_CONFIG_HOME:="$HOME/.config"}"

# Read configuration files if there are any
# shellcheck source=/dev/null
[ -r "/etc/fig/figrc" ]            && . "/etc/fig/figrc"
# shellcheck source=/dev/null
[ -r "$XDG_CONFIG_HOME/fig/.figrc" ] && . "$XDG_CONFIG_HOME/fig/.figrc"
if [ -n "$FIG_OPTION_CONFIG" ]; then
	# Source $FIG_OPTION_CONFIG if it can be read and is in $PWD of $PATH
	if [ -r "$FIG_OPTION_CONFIG" ]; then
		source_all "$FIG_OPTION_CONFIG"
	else
		fatal "Can not read configuration file '$FIG_OPTION_CONFIG'" 1
	fi
fi
[ -n "$FIG_DEBUG" ]                  && set -vx

# Read defaults
: "${FIG_REPO_D:="$XDG_CONFIG_HOME/fig"}"; export FIG_REPO_D
: "${FIG_HOOK_D:="$XDG_CONFIG_HOME/fig/hooks"}"; export FIG_HOOK_D
: "${FIG_OVERLAY_D:="$XDG_CONFIG_HOME/fig/overlays"}"; export FIG_OVERLAY_D
: "${FIG_REPOS:="$XDG_CONFIG_HOME/fig/.repos"}"; export FIG_REPOS
: "${FIG_BASE:="$HOME"}"; export FIG_BASE
: "${FIG_GITIGNORE:=exact}"; export FIG_GITIGNORE
: "${FIG_GITATTRIBUTES:=none}"; export FIG_GITATTRIBUTES
: "${FIG_WORKTREE:=absolute}"; export FIG_WORKTREE
: "${FIG_SHOW_UNTRACKED:=no}"; export FIG_SHOW_UNTRACKED
: "${FIG_GITCONFIG:="$XDG_CONFIG_HOME/fig/.gitconfig"}"; export FIG_GITCONFIG
: "${FIG_GITIGNORE_FILE:="$XDG_CONFIG_HOME/fig/.gitignore"}"; export FIG_GITIGNORE_FILE
: "${FIG_GITATTRIBUTES_FILE:="$XDG_CONFIG_HOME/fig/.gitattributes"}"; export FIG_GITATTRIBUTES_FILE

if [ ! "x$FIG_GITIGNORE" = 'xexact' ] && [ ! "x$FIG_GITIGNORE" = 'xnone' ] && [ ! "x$FIG_GITIGNORE" = 'xrecursive' ]; then
	fatal "'\$FIG_GITIGNORE' must equal 'exact', 'none', or 'recursive'" 1
fi

if [ ! "x$FIG_WORKTREE" = 'xabsolute' ] && [ ! "x$FIG_WORKTREE" = 'xrelative' ]; then
	fatal "'\$FIG_WORKTREE' must equal 'absolute', or 'relative'" 1
fi


# editorconfig-checker-disable
help() {
	echo "usage: $FIG_SELF <options> <command>

   options:
   -c <file>            Source file
   -d                   Enable debug mode
   -v                   Enable verbose mode

   commands:
   add <repo> [<tags>]  Add <repo>'s line to \$FIG_REPOS; <tags> is an
                        optional comma-separated list (4th column)
   add --all | -a       Append every local repo with a remote not already
                        in \$FIG_REPOS (written without tags)
   clone [-b <branch>] \\
         <remote> \\
         [<repo>]       Clone from an existing repository
   commit               Commit in all repositories
   config \\
     [<git config args>] Edit shared git config included by every repo
                        (\$FIG_GITCONFIG); no args lists it
   delete <repo>        Delete an existing repository
   enter <repo>         Enter repository; spawn new instance of \$SHELL
                        with \$GIT_DIR set.
   foreach \\
     [<-g>] [<-p>] \\
     <git command>      Execute a command for every repository
   help                 Display this help text
   init <repo>          Initialize a new repository
   list                 List all repositories
   list-tracked \\
        [<repo>]        List all files tracked all or one repositories
   list-untracked \\
        [<-a>] [<-r>]
        [<repo>]        List all files not tracked by all or one repositories
   pull                 Pull from all fig remotes
   push                 Push to fig remotes
   bootstrap \\
     [--include=<tags>] \\
     [--exclude=<tags>] \\
     [@<tags>] \\
     [<file>]           Clone every repo in \$FIG_REPOS (populate it with
                        'add') not already present. With --include (or a bare
                        '@tag' / '@a,b' positional), only rows whose 4th-column
                        tags match (untagged rows always match); --exclude
                        drops rows with a matching tag. A leading '@' on any
                        tag is optional. Also: 'clone --all|-a [same opts]'
                        and 'clone @<tags> [same opts]'.
   rename <repo> \\
          <newname>     Rename repository
   run <repo> \\
       <command>        Use this repository
   status \\
     [--terse] [<repo>] Show statuses of all/one fig repositories
   sync [<message>]     Add -u, commit, and push every repo in one step;
                        <message> defaults to "update"
   upgrade <repo>       Upgrade repository to currently recommended settings
   version              Print version information
   which <substring>    Find substring in name of any tracked file
   write-gitignore \\
   [<repo>]             Write <repo>.fig/.gitignore via git ls-files

   <repo> <git command> Shortcut to run git commands directly
   <repo>               Shortcut to enter repository" >&2
}
# editorconfig-checker-enable

debug() {
	if [ -n "$FIG_DEBUG" ]; then echo "$FIG_SELF: debug: $*"; fi
}

verbose() {
	if [ -n "$FIG_DEBUG" ] || [ -n "$FIG_VERBOSE" ]; then
		echo "$FIG_SELF: verbose: $*"
	fi
}

error() {
	echo "$FIG_SELF: error: $1" >&2
}

info() {
	echo "$FIG_SELF: info: $1"
}

clone() {
	hook pre-clone
	# Check if remote is reachable. Abort early if there's a typo, TLS certificate problem, etc
	@GIT@ ls-remote "$GIT_REMOTE" 2> /dev/null || fatal "Can not reach '$GIT_REMOTE'"
	init
	# Test which, if any, given or detected branches can be pulled from.
	# In a future version, if we need the logic, we could do the following:
	#   git ls-remote ORIGIN
	#   get HEAD commit ID
	#   see what refs/heads/* match that commit ID
	#   set FIG_BRANCH if only one match
	#   offer a list of all matching refs for the user to choose
	for FIG_BRANCH_TEST in "$FIG_BRANCH" master trunk development; do
		if [ $(@GIT@ ls-remote "$GIT_REMOTE" "$FIG_BRANCH_TEST" 2> /dev/null | @WC@ -l ) -lt 1 ]; then
			info "remote branch '$FIG_BRANCH_TEST' empty"
		else
			info "remote branch '$FIG_BRANCH_TEST' found"
			FIG_BRANCH_REMOTE=$FIG_BRANCH_TEST
			break
		fi
	done
	if [ -z "$FIG_BRANCH_REMOTE" ]; then
		info "No non-empty remote branches found, aborting. Please run `$0 delete $FIG_REPO_NAME`, determine the correct branch, and try again."
		exit
	fi
	FIG_BRANCH=$FIG_BRANCH_REMOTE

	# Set up remote
	@GIT@ remote add origin "$GIT_REMOTE"
	@GIT@ checkout -b "$FIG_BRANCH" || return $?
	@GIT@ config branch."$FIG_BRANCH".remote origin
	@GIT@ config branch."$FIG_BRANCH".merge  refs/heads/"$FIG_BRANCH"
	GIT_VERSION_MAJOR=$(@GIT@ --version | @SED@ -E -n 's/.* ([0-9]+)\..*/\1/p' )
	if [ 1 -lt "$GIT_VERSION_MAJOR" ];then
		@GIT@ fetch origin "$FIG_BRANCH"
	else
		@GIT@ fetch origin
	fi
	hook pre-merge
	@GIT@ read-tree -n -mu origin/"$FIG_BRANCH" \
		|| fatal "will stop after fetching and not try to merge!
  Once this situation has been resolved, run 'fig $FIG_REPO_NAME pull' to finish cloning." 17 # editorconfig-checker-disable-line
	@GIT@ -c merge.ff=true merge origin/"$FIG_BRANCH"
	hook post-merge
	hook post-clone
	retire
	hook post-clone-retired
}

commit() {
	hook_global pre-commit
	shift  # remove the "commit" command.
	# shellcheck disable=SC2039,SC3043
	local fig_repos fig_repo_count
	fig_repos=$(list)
	fig_repo_count=$(printf '%s\n' "$fig_repos" | @GREP@ -c .)
	for FIG_REPO_NAME in $fig_repos; do
		export FIG_REPO_NAME
		# The "<repo>: " label only earns its keep when there's more than one
		# repo to tell apart; with a single repo it's just a line with
		# nothing useful after it.
		if [ "$fig_repo_count" -gt 1 ]; then
			echo "$FIG_REPO_NAME: "
		fi
		GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-commit
		@GIT@ commit --untracked-files=no --quiet "$@"
		hook_repo post-commit
		FIG_COMMAND_RETURN_CODE=$?
	done
	hook_global post-commit
}

delete() {
	cd "$FIG_BASE" || fatal "could not enter '$FIG_BASE'" 11
	use
	info "This operation WILL DESTROY DATA!"
	files=$(@GIT@ ls-files)
	echo "These files will be deleted:

$files

AGAIN, THIS WILL DELETE YOUR DATA!
To continue, type 'Yes, do as I say'"
	read -r answer
	[ "x$answer" = 'xYes, do as I say' ] || exit 16
	# Use -z/-0 so that paths containing whitespace, shell globbing
	# characters, or non-ASCII bytes (which `git ls-files` would otherwise
	# C-quote) are handled verbatim; `--` guards against leading dashes.
	@GIT@ ls-files -z | xargs -0 rm -f -- ||
		info "could not delete some files, continuing with repository deletion"
	# Remove the whole <name>.fig/ container (git dir, per-repo config,
	# per-repo gitignore/gitattributes).
	rm -rf "${GIT_DIR%/*}" || error "could not delete '${GIT_DIR%/*}'"
}

enter() {
	hook pre-enter
	use
	$SHELL
	hook post-enter
}

foreach() {
	hook_global pre-foreach

	# We default to prefixing `git` to all commands passed to foreach, but
	# allow running in general context with -g
	command_prefix=@GIT@
	# shellcheck disable=SC2220
	while getopts gp flag; do
		case "$flag" in
			g) unset command_prefix ;;
			p) FIG_PRINT_REPO_PREFIX=1 ;;
		esac
	done
	shift $((OPTIND-1))
	export FIG_PRINT_REPO_PREFIX
	# shellcheck disable=SC2039,SC3043
	local fig_repos fig_repo_count
	fig_repos=$(list)
	fig_repo_count=$(printf '%s\n' "$fig_repos" | @GREP@ -c .)
	for FIG_REPO_NAME in $fig_repos; do
		export FIG_REPO_NAME
		GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-foreach
		if [ -n "${FIG_PRINT_REPO_PREFIX+x}" ]; then
			$command_prefix "$@" | @SED@ "s/^/$FIG_REPO_NAME: /"
		elif [ "$fig_repo_count" -gt 1 ]; then
			echo "$FIG_REPO_NAME:"
			$command_prefix "$@"
		else
			$command_prefix "$@"
		fi
		hook_repo post-foreach
	done
	hook_global post-foreach
}

git_dir_exists() {
	[ -d "$GIT_DIR" ] || fatal "no repository found for '$FIG_REPO_NAME'" 12
}

hook_global() {
	for hook in "$FIG_HOOK_D/$1"*; do
		[ -x "$hook" ] || continue
		verbose "executing '$hook'"
		"$hook"
	done
}

hook_repo() {
	for hook in "$FIG_HOOK_D/$FIG_REPO_NAME.$1"*; do
		[ -x "$hook" ] || continue
		verbose "executing '$hook'"
		"$hook" || fatal "hook [$hook] failed" 1
	done
}

hook() {
	hook_global "$1"
	hook_repo "$1"
}

init() {
	hook pre-init
	[ ! -e "$GIT_DIR" ] || fatal "'$GIT_DIR' exists" 10
	mkdir -p "$FIG_BASE" || fatal "could not create '$FIG_BASE'" 50
	mkdir -p "${GIT_DIR%/*}" || fatal "could not create '${GIT_DIR%/*}'" 50
	cd "$FIG_BASE" || fatal "could not enter '$FIG_BASE'" 11
	@GIT@ init --shared=false
	upgrade
	hook post-init
}

list() {
	for repo in "$FIG_REPO_D"/*.fig; do
		[ -d "$repo" ] || continue
		name=$(basename "$repo" .fig)
		[ -d "$repo/$name.git" ] && [ -r "$repo/$name.git" ] && echo "$name"
	done
}

list_has_remote() {
	for FIG_REPO_NAME in $(list); do
		GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
		# This command returns the tracking branch of the currently-checked-out local
		# branch, if any. See https://stackoverflow.com/a/9753364
		[ -n  "$(@GIT@ for-each-ref "$(@GIT@ symbolic-ref -q HEAD)")" ] && echo "$FIG_REPO_NAME"
	done
}

config() {
	# Read/write $FIG_GITCONFIG, a git config file that every fig repo
	# includes (wired up by upgrade()). Args are passed straight to
	# `git config`, e.g.  fig config credential.helper '!gh auth git-credential'
	# With no args, list the current contents.
	shift
	[ -e "$FIG_GITCONFIG" ] || : > "$FIG_GITCONFIG" ||
		fatal "could not create '$FIG_GITCONFIG'" 50
	[ "$#" -eq 0 ] && set -- --list
	# Run from / so a stray/broken .git in the cwd's ancestry (e.g. a
	# leftover gitlink in $HOME) cannot make repo discovery fail here.
	@GIT@ -C / config --file "$FIG_GITCONFIG" "$@"
	FIG_COMMAND_RETURN_CODE=$?
}

repos_has() {
	# True if $FIG_REPOS has a non-comment line for repo name $1.
	local _n _rest
	[ -r "$FIG_REPOS" ] || return 1
	while read -r _n _rest || [ -n "$_n" ]; do
		case "$_n" in ''|\#*) continue;; esac
		[ "x$_n" = "x$1" ] && return 0
	done < "$FIG_REPOS"
	return 1
}

repos_line() {
	# Print "<name> <url> <branch> @tags," for repo $1 ($2 = optional tag list).
	# Tags are always emitted with a leading '@' and a trailing ',' so the
	# column is unambiguous; a leading '@' or trailing ',' in $2 is absorbed.
	# Return 1 if the repo has no origin URL.
	local url branch tags
	GIT_DIR=$FIG_REPO_D/$1.fig/$1.git; export GIT_DIR
	url=$(@GIT@ config --get remote.origin.url 2> /dev/null) || return 1
	[ -n "$url" ] || return 1
	branch=$(@GIT@ symbolic-ref --quiet --short HEAD 2> /dev/null) || branch=
	tags=${2#@}; tags=${tags%,}
	printf '%s %s %s%s\n' "$1" "$url" "$branch" "${tags:+ @$tags,}"
}

repos_append() {
	# Append "$1" (a repos_line string) to $FIG_REPOS, creating it with a
	# header if needed.
	[ -e "$FIG_REPOS" ] || echo "# fig repos -- <name> <url> <branch> @tags,   (tags optional)" > "$FIG_REPOS" ||
		fatal "add: could not create '$FIG_REPOS'" 50
	printf '%s\n' "$1" >> "$FIG_REPOS" || fatal "add: could not write '$FIG_REPOS'" 50
}

add() {
	shift  # drop the "add" command word
	case ${1:-} in
		--all|-a)
			local n line
			n=0
			for FIG_REPO_NAME in $(list); do
				repos_has "$FIG_REPO_NAME" && continue
				line=$(repos_line "$FIG_REPO_NAME") || continue
				repos_append "$line"
				info "added '$FIG_REPO_NAME'"
				n=$((n + 1))
			done
			info "$n repo(s) appended to '$FIG_REPOS'"
			;;
		'')
			fatal "add: specify a repository name, or --all / -a" 1
			;;
		*)
			local line tags
			[ -d "$FIG_REPO_D/$1.fig/$1.git" ] || fatal "add: no such repository: '$1'" 12
			if repos_has "$1"; then
				info "'$1' is already in '$FIG_REPOS'"
				return 0
			fi
			line=$(repos_line "$1" "${2:-}") || fatal "add: '$1' has no 'origin' remote" 1
			repos_append "$line"
			tags=${2#@}; tags=${tags%,}
			info "added '$1' to '$FIG_REPOS'${tags:+ (tags: @$tags,)}"
			;;
	esac
}

tag_match() {
	# $1 = a line's tags (comma list, may be empty)
	# $2 = --include tags (comma list, may be empty)
	# $3 = --exclude tags (comma list, may be empty)
	# Returns 0 if the line should be cloned.
	#   - an untagged row always matches (it is "universal")
	#   - a tagged row is opt-in: it matches only if one of its tags was
	#     passed via --include; a bare `bootstrap` (no --include) skips it
	#   - --exclude always wins
	# All three inputs are normalised the same way: lower-cased, split on
	# ',', and a leading '@' on any tag is dropped -- so `--include=@laptop`
	# and `--include=laptop` behave identically.
	local lt inc exc t x i
	lt=$(printf '%s' "$1" | tr 'A-Z,@' 'a-z  ')
	inc=$(printf '%s' "$2" | tr 'A-Z,@' 'a-z  ')
	exc=$(printf '%s' "$3" | tr 'A-Z,@' 'a-z  ')
	# exclude wins
	for x in $exc; do
		for t in $lt; do [ "$t" = "$x" ] && return 1; done
	done
	# untagged (universal) row -> always keep
	[ -z "$lt" ] && return 0
	# tagged row -> keep only if one of its tags is in --include
	for i in $inc; do
		for t in $lt; do [ "$t" = "$i" ] && return 0; done
	done
	return 1
}

bootstrap() {
	# Clone every repo listed in $FIG_REPOS that is not already present.
	# Reached as `fig bootstrap [opts] [<file>]` or
	# `fig clone --all|-a [opts] [<file>]`.
	# opts: --include=tag,tag  --exclude=tag,tag  @tag[,tag]
	# A bare "@tag" (or "@a,b") positional is shorthand for --include=tag;
	# repeated --include/--exclude/@tag args accumulate.
	shift  # drop the command word
	local inc exc source_file a
	inc= exc= source_file=$FIG_REPOS
	for a in "$@"; do
		case $a in
			--include=*) inc="${inc:+$inc,}${a#--include=}" ;;
			--exclude=*) exc="${exc:+$exc,}${a#--exclude=}" ;;
			--include|--exclude) fatal "bootstrap: use $a=tag,tag" 1 ;;
			@*) inc="${inc:+$inc,}$a" ;;
			-*) fatal "bootstrap: unknown option '$a'" 1 ;;
			*) source_file=$a ;;
		esac
	done
	[ -r "$source_file" ] || fatal "$FIG_COMMAND: repos file not readable: '$source_file'" 1
	# Fields are whitespace-separated; none of name/url/branch can contain a space.
	while read -r name url branch tags || [ -n "$name" ]; do
		tags=${tags#@}
		case "$name" in ''|\#*) continue;; esac
		if [ -z "$url" ]; then
			info "skipping '$name': no URL in repos file"
			continue
		fi
		if ! tag_match "$tags" "$inc" "$exc"; then
			verbose "skipping '$name': tags '${tags:-none}' do not match filter"
			continue
		fi
		if [ -e "$FIG_REPO_D/$name.fig/$name.git" ]; then
			info "skipping '$name': already present"
			continue
		fi
		info "cloning '$name' from '$url'"
		if [ -n "$branch" ]; then
			"$0" clone -b "$branch" "$url" "$name" || error "failed to clone '$name'"
		else
			"$0" clone "$url" "$name" || error "failed to clone '$name'"
		fi
	done < "$source_file"
}

get_files() {
	GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
	@GIT@ ls-files --full-name
}

list_tracked() {
	FIG_REPO_NAME=$2; export FIG_REPO_NAME
	if [ -n "$FIG_REPO_NAME" ]; then
		get_files | list_tracked_helper
	else
		for FIG_REPO_NAME in $(list); do
			get_files
		done | list_tracked_helper
	fi
}

list_tracked_helper() {
	@SED@ "s,^,$(printf '%s\n' "$FIG_BASE/" | @SED@ 's/[,\&]/\\&/g')," | sort -u
}

list_tracked_by() {
	list_tracked '' "$2"
}

list_untracked() {
	temp_file_others=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'
	temp_file_untracked=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'
	temp_file_untracked_copy=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") || fatal 'Could not create temp file'

	# Hack in support for `fig list-untracked -r`...
	exclude_standard_opt='--exclude-standard'
	directory_opt='--directory'
	shift
	while getopts ar flag; do
		case "$flag" in
			a) unset exclude_standard_opt ;;
			r) unset directory_opt ;;
		esac
	done
	shift $((OPTIND-1))
	# ...and parse for a potential parameter afterwards. As we shifted things out of $* in during getops, we need to look at $1
	FIG_REPO_NAME=$1; export FIG_REPO_NAME

	if [ -n "$FIG_REPO_NAME" ]; then
		list_untracked_helper "$FIG_REPO_NAME"
	else
		for FIG_REPO_NAME in $(list); do
			list_untracked_helper "$FIG_REPO_NAME"
		done
	fi
	cat "$temp_file_untracked"

	unset directory_opt directory_component
	rm -f "$temp_file_others" "$temp_file_untracked" "$temp_file_untracked_copy" || fatal 'Could not delete temp files'
}

list_untracked_helper() {
	export GIT_DIR="$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git"
	@GIT@ ls-files --others $exclude_standard_opt $directory_opt | (
		while read -r line; do
			echo "$line"
			directory_component=${line%%/*}
			[ -d "$directory_component" ] && printf '%s/\n' "$directory_component"
		done
		) | sort -u > "$temp_file_others"
	if [ -z "$ran_once" ]; then
		ran_once=1
		cp "$temp_file_others" "$temp_file_untracked" || fatal 'Could not copy temp file'
	fi
	cp "$temp_file_untracked" "$temp_file_untracked_copy" || fatal 'Could not copy temp file'
	@COMM@ -12 "$temp_file_others" "$temp_file_untracked_copy" > "$temp_file_untracked"
}

pull() {
	hook_global pre-pull
	# shellcheck disable=SC2039,SC3043
	local fig_repos fig_repo_count
	fig_repos=$(list_has_remote)
	fig_repo_count=$(printf '%s\n' "$fig_repos" | @GREP@ -c .)
	for FIG_REPO_NAME in $fig_repos; do
		export FIG_REPO_NAME
		if [ "$fig_repo_count" -gt 1 ]; then
			printf '%s: ' "$FIG_REPO_NAME"
		fi
		GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-pull
		@GIT@ pull
		hook_repo post-pull
		FIG_COMMAND_RETURN_CODE=$?
	done
	hook_global post-pull
}

push() {
	hook_global pre-push
	# shellcheck disable=SC2039,SC3043
	local fig_repos fig_repo_count
	fig_repos=$(list_has_remote)
	fig_repo_count=$(printf '%s\n' "$fig_repos" | @GREP@ -c .)
	for FIG_REPO_NAME in $fig_repos; do
		export FIG_REPO_NAME
		if [ "$fig_repo_count" -gt 1 ]; then
			printf '%s: ' "$FIG_REPO_NAME"
		fi
		GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
		use
		hook_repo pre-push
		@GIT@ push
		hook_repo post-push
		FIG_COMMAND_RETURN_CODE=$?
	done
	hook_global post-push
}

sync() {
	# `fig sync [<message>...]`: add -u, commit, and push every repo in one
	# step. <message> (multiple words are joined with spaces) defaults to
	# "update". Prints "Adding.../Committing.../Pushing..." phase labels, but
	# only when there's more than one repo -- with a single repo there's
	# nothing to disambiguate, matching commit/pull/push's own rule.
	hook_global pre-sync
	shift  # drop "sync"
	# shellcheck disable=SC2039,SC3043
	local msg fig_repos fig_repo_count
	if [ $# -eq 0 ]; then
		msg=update
	else
		msg=$*
	fi
	fig_repos=$(list)
	fig_repo_count=$(printf '%s\n' "$fig_repos" | @GREP@ -c .)
	[ "$fig_repo_count" -gt 1 ] && echo "Adding..."
	foreach add -u
	[ "$fig_repo_count" -gt 1 ] && echo "Committing..."
	commit sync -m "$msg"
	[ "$fig_repo_count" -gt 1 ] && echo "Pushing..."
	push
	hook_global post-sync
}

retire() {
	unset FIG_DIRECTORY
}

rename() {
	git_dir_exists
	fig_dir_old=${GIT_DIR%/*}
	fig_dir_new=${GIT_DIR_NEW%/*}
	[ -e "$fig_dir_new" ] && fatal "'$fig_dir_new' exists" 54
	# Move the whole <name>.fig/ container, then rename the git dir inside it.
	mv -f "$fig_dir_old" "$fig_dir_new" ||
		fatal "Could not mv '$fig_dir_old' '$fig_dir_new'" 52
	mv -f "$fig_dir_new/$FIG_REPO_NAME.git" "$GIT_DIR_NEW" ||
		fatal "Could not rename git dir to '$GIT_DIR_NEW'" 52

	# Now that the repository has been renamed, we need to fix up its configuration
	# Overwrite old name..
	GIT_DIR=$GIT_DIR_NEW
	FIG_REPO_NAME=$FIG_REPO_NAME_NEW
	# ..and clobber all old configuration
	upgrade
}

run() {
	hook pre-run
	use
	"$@"
	FIG_COMMAND_RETURN_CODE=$?
	hook post-run
}

# Smart implicit -f for `fig <repo> add ...`.
#
# fig's fallback ignore file is a single `*`, so every deliberate `add` of a
# path would otherwise need `-f`. This transparently supplies it -- but ONLY
# when the catch-all `*` is the sole thing in the way, or the path is one git
# already tracks (re-adding a tracked path is always safe, and without this
# git stages it anyway but also prints a confusing "ignored ... use -f"
# refusal). If any untracked pathspec is matched by a more specific pattern
# (a hand-written rule in a per-repo .gitignore, .git/info/exclude, ...) we
# stay out of the way and let git's normal "use -f" refusal happen, so a
# deliberate ignore is never bypassed.
#
# Also skipped for bulk forms (. -A --all -u --update -n --dry-run ...), when
# -f/--force is already present, or when FIG_ADD_FORCE=no. $@ is the git
# words starting with "add"; GIT_DIR must already be exported. Prints nothing;
# returns 0 if `-f` should be injected.
auto_add_force() {
	[ x"${FIG_ADD_FORCE:-}" = x'no' ] && return 1
	# shellcheck disable=SC2039,SC3043
	local a ddash forced skip blanket deliberate pat
	ddash=0; forced=0; skip=0; blanket=0; deliberate=0
	for a in "$@"; do
		[ "$ddash" = 1 ] && continue
		case $a in
			add) ;;
			--) ddash=1 ;;
			.|-A|--all|--no-ignore-removal|-u|--update|-n|--dry-run|--refresh|--pathspec-from-file|--pathspec-from-file=*|--pathspec-file-nul|-i|--interactive)
				skip=1 ;;
			-f|--force) forced=1 ;;
			--*) ;;
			-*) case $a in *f*) forced=1 ;; esac ;;
			*) ;;
		esac
	done
	{ [ "$skip" = 1 ] || [ "$forced" = 1 ]; } && return 1
	ddash=0
	for a in "$@"; do
		[ x"$a" = x'add' ] && continue
		if [ "$ddash" = 0 ]; then
			case $a in
				--) ddash=1; continue ;;
				-*) continue ;;
			esac
		fi
		# Re-adding a path git already tracks is always safe -- there's no
		# risk of accidentally starting to track something new, whatever the
		# ignore rules say (and without this, git still stages the change
		# but ALSO prints the scary "ignored ... use -f" refusal, because
		# its ignore check runs on the pathspec's ancestor directories, not
		# on tracked-status).
		if @GIT@ ls-files --error-unmatch -- "$a" > /dev/null 2>&1; then
			blanket=1
			continue
		fi
		# `check-ignore -v` prints the last matching line even when it is a
		# negation (path NOT ignored), so treat a leading '!' as "not ignored".
		pat=$(printf '%s\0' "$a" | @GIT@ check-ignore -v -z --stdin 2> /dev/null | tr '\0' '\n' | @SED@ -n '3p')
		case $pat in
			''|'!'*) ;;
			'*') blanket=1 ;;
			*) deliberate=1 ;;
		esac
	done
	[ "$deliberate" = 0 ] && [ "$blanket" = 1 ]
}

status() {
	if [ -t 1 ]; then
		COLORING="-c color.status=always"
	fi
	if [ -n "$FIG_REPO_NAME" ]; then
		status_helper "$FIG_REPO_NAME"
	else
		for FIG_REPO_NAME in $(list); do
			STATUS="$(status_helper "$FIG_REPO_NAME" "$COLORING")"
			[ -n "$STATUS" ] || [ -z "$FIG_STATUS_TERSE" ] && echo "$FIG_REPO_NAME:"
			[ -n "$STATUS" ]            && echo "$STATUS"
			[ -z "$FIG_STATUS_TERSE" ] && echo
		done
	fi
}

# Warning: disabled quoting check here due to all of them relating to
#          wc -l  output and a deliberate lack of quoting for git args.
# shellcheck disable=SC2086
status_helper() {
	GIT_DIR=$FIG_REPO_D/$1.fig/$1.git; export GIT_DIR
	FIG_GIT_OPTIONS="-c status.relativePaths=false $2"
	use
	# Shellcheck isn't understanding a complex block.
	# shellcheck disable=SC1083
	remote_tracking_branch=$(@GIT@ rev-parse --abbrev-ref --symbolic-full-name @{u} 2> /dev/null) && {
		commits_behind=$(@GIT@ log ..${remote_tracking_branch} --oneline | @WC@ -l)
		commits_ahead=$(@GIT@ log ${remote_tracking_branch}.. --oneline | @WC@ -l)
		[ ${commits_behind} -ne 0 ] && echo "Behind $remote_tracking_branch by $commits_behind commits"
		[ ${commits_ahead} -ne 0 ] && echo "Ahead of $remote_tracking_branch by $commits_ahead commits"
	}
	@GIT@ ${FIG_GIT_OPTIONS} status --short --untracked-files='no' | @SED@ -E 's@([^ ] +)@\1~/@'
	FIG_COMMAND_RETURN_CODE=$?
}

upgrade() {
	hook pre-upgrade
	# fake-bare repositories are not bare, actually. Set this to false
	# because otherwise Git complains "fatal: core.bare and core.worktree
	# do not make sense"
	@GIT@ config core.bare false
	# core.worktree may be absolute or relative to $GIT_DIR, depending on
	# user preference
	if [ ! "x$FIG_WORKTREE" = 'xabsolute' ]; then
		@GIT@ config core.worktree "$(cd "$GIT_DIR" && GIT_WORK_TREE=$FIG_BASE @GIT@ rev-parse --show-cdup)"
	elif [ ! "x$FIG_WORKTREE" = 'xrelative' ]; then
		@GIT@ config core.worktree "$FIG_BASE"
	fi
	# Per-repo exclude/attributes file lives in <name>.fig/ next to the
	# git dir; if absent, fall back to the shared file in $XDG_CONFIG_HOME/fig.
	if [ ! "x$FIG_GITIGNORE" = 'xnone' ]; then
		if [ -e "${GIT_DIR%/*}/.gitignore" ]; then
			@GIT@ config core.excludesfile "${GIT_DIR%/*}/.gitignore"
		else
			@GIT@ config core.excludesfile "$FIG_GITIGNORE_FILE"
		fi
	fi
	if [ ! "x$FIG_GITATTRIBUTES" = 'xnone' ]; then
		if [ -e "${GIT_DIR%/*}/.gitattributes" ]; then
			@GIT@ config core.attributesfile "${GIT_DIR%/*}/.gitattributes"
		else
			@GIT@ config core.attributesfile "$FIG_GITATTRIBUTES_FILE"
		fi
	fi
	@GIT@ config fig.fig 'true'
	# Hide the rest of $HOME from `git status` in this repo. Override with
	# FIG_SHOW_UNTRACKED=normal (or per repo: fig <repo> config
	# status.showUntrackedFiles normal).
	@GIT@ config status.showUntrackedFiles "$FIG_SHOW_UNTRACKED"
	# Pull in shared settings (credential.helper, user.*, ...) that apply to
	# every fig repo. Edit that file with `fig config ...`.
	@GIT@ config --replace-all include.path "$FIG_GITCONFIG"
	use
	hook post-upgrade
}

use() {
	git_dir_exists
	FIG_DIRECTORY=$FIG_REPO_NAME; export FIG_DIRECTORY
}

which() {
	# It's ok to modify FIG_REPO_NAME in a subshell.
	# shellcheck disable=SC2030
	output=$(for FIG_REPO_NAME in $(list); do
		get_files | @GREP@ -- "$FIG_COMMAND_PARAMETER" | @SED@ "s/^/$FIG_REPO_NAME: /"
	done | sort -u)
	if [ -z "$output" ]; then
		fatal "'$FIG_COMMAND_PARAMETER' does not exist" 1
	else
		echo "$output"
	fi
}

# Ignore warnings about FIG_REPO_NAME being changed in a subshell.
# shellcheck disable=SC2031
write_gitignore() {
	# Don't do anything if the user does not want to write gitignore
	if [ "x$FIG_GITIGNORE" = 'xnone' ]; then
		info "Not writing gitignore as '\$FIG_GITIGNORE' is set to 'none'"
		exit
	fi

	use
	cd "$FIG_BASE" || fatal "could not enter '$FIG_BASE'" 11
	# Works in all shells we care about.
	# shellcheck disable=SC2039,SC3043
	local GIT_VERSION GIT_VERSION_MAJOR GIT_VERSION_MINOR
	GIT_VERSION="$(@GIT@ --version)"
	GIT_VERSION_MAJOR="$(echo "$GIT_VERSION" | @SED@ -E -n 's/.* ([0-9]+)\..*/\1/p')"
	GIT_VERSION_MINOR="$(echo "$GIT_VERSION" | @SED@ -E -n 's/.* ([0-9]+)\.([0-9]+)\..*/\2/p')"
	OLDIFS=$IFS
	IFS=$(printf '\n\t')
	gitignores=$(for file in $(@GIT@ ls-files); do
		while true; do
			echo "$file"; new=${file%/*}
			[ x"$file" = x"$new" ] && break
			file=$new
		done;
	done | sort -u)

	# Contrary to GNU mktemp, mktemp on BSD/OSX requires a template for temp files
	# Using a template makes GNU mktemp default to $PWD and not #TMPDIR for tempfile location
	# To make every OS happy, set full path explicitly
	local tempfile
	tempfile=$(mktemp "${TMPDIR:-/tmp}/tmp.XXXXXXXXXX") ||
		fatal "could not create tempfile: '${tempfile}'" 51

	echo '*' > "$tempfile" || fatal "could not write to '$tempfile'" 57
	for gitignore in $gitignores; do
		echo "$gitignore" | @SED@ 's@^@!/@' >> "$tempfile" ||
			fatal "could not write to '$tempfile'" 57
		if [ "x$FIG_GITIGNORE" = 'xrecursive' ] && [ -d "$gitignore" ]; then
			{ echo "$gitignore/*" | @SED@ 's@^@!/@' >> "$tempfile" ||
				fatal "could not write to '$tempfile'" 57; }
		fi
	done
	IFS=$OLDIFS
	local GIT_IGNORE_PATH
	GIT_IGNORE_PATH="${GIT_DIR%/*}/.gitignore"
	if diff -N "$tempfile" "$GIT_IGNORE_PATH" > /dev/null; then
		info "'$GIT_IGNORE_PATH' already up to date"
		rm -f "$tempfile" || fatal "could not delete '$tempfile'" 59
		return
	fi
	if [ -e "$GIT_IGNORE_PATH" ]; then
		info "'$GIT_IGNORE_PATH' differs from new data, moving it to '$GIT_IGNORE_PATH.bak'"
		mv -f "$GIT_IGNORE_PATH" "$GIT_IGNORE_PATH.bak" ||
			fatal "could not move '$GIT_IGNORE_PATH' to '$GIT_IGNORE_PATH.bak'" 53
	fi
	mv -f "$tempfile" "$GIT_IGNORE_PATH" ||
		fatal "could not move '$tempfile' to '$GIT_IGNORE_PATH'" 53
}

debug "$(@GIT@ version)"

if [ ! "x$FIG_GITIGNORE" = 'xexact' ] && [ ! "x$FIG_GITIGNORE" = 'xnone' ] && [ ! "x$FIG_GITIGNORE" = 'xrecursive' ]; then
	fatal "'\$FIG_GITIGNORE' must equal 'exact', 'none', or 'recursive'" 1
fi

FIG_COMMAND=$1; export FIG_COMMAND

case $FIG_COMMAND in
	clon|clo|cl) FIG_COMMAND=clone;;
	commi|comm|com|co|ci) FIG_COMMAND=commit;;
	confi|conf|con) FIG_COMMAND=config;;
	delet|dele|del|de) FIG_COMMAND=delete;;
	ente|ent|en) FIG_COMMAND=enter;;
	hel|he) FIG_COMMAND=help;;
	ini|in) FIG_COMMAND=init;;
	pul) FIG_COMMAND=pull;;
	pus) FIG_COMMAND=push;;
	renam|rena|ren|re) FIG_COMMAND=rename;;
	ru) FIG_COMMAND=run;;
	statu|stat|sta|st) FIG_COMMAND=status;;
	sync|syn|sy) FIG_COMMAND=sync;;
	upgrad|upgra|upgr|up) FIG_COMMAND=upgrade;;
	versio|versi|vers|ver|ve) FIG_COMMAND=version;;
	which|whi|wh) FIG_COMMAND=which;;
	write|writ|wri|wr) FIG_COMMAND=write-gitignore;;
	bootstra|bootstr|bootst|boots|boot) FIG_COMMAND=bootstrap;;
esac

# `fig clone --all|-a [opts]` and `fig clone @tag[,tag] [opts]` are aliases
# for `fig bootstrap [opts]`.
if [ x"$FIG_COMMAND" = x'clone' ] && { [ x"$2" = 'x--all' ] || [ x"$2" = 'x-a' ]; }; then
	FIG_COMMAND=bootstrap
	shift 2                 # drop "clone" and "--all"/"-a"
	set -- bootstrap "$@"   # leaves $2 as the optional <file>
elif [ x"$FIG_COMMAND" = x'clone' ]; then
	case ${2:-} in
		@*)
			FIG_COMMAND=bootstrap
			shift              # drop "clone"; keep "@tag" and any opts
			set -- bootstrap "$@"
			;;
	esac
fi

if [ x"$FIG_COMMAND" = x'clone' ]; then
	FIG_BRANCH=
	if [ "$2" = -b ]; then
		FIG_BRANCH=$3
		shift
		shift
	fi
	[ -z "$2" ] && fatal "$FIG_COMMAND: please specify a remote" 1
	GIT_REMOTE="$2"
	[ -n "$FIG_BRANCH" ] || if [ "$3" = -b ]; then
		FIG_BRANCH=$4
		shift
		shift
	fi
	if [ -n "$3" ]; then
		FIG_REPO_NAME=$3
		[ -z "$FIG_BRANCH" ] && [ "$4" = -b ] && FIG_BRANCH=$5
	else
		FIG_REPO_NAME=$(basename "${GIT_REMOTE#*:}" .git)
	fi
	[ -z "$FIG_REPO_NAME" ] && fatal "$FIG_COMMAND: could not determine repository name" 1
	export FIG_REPO_NAME
	[ -n "$FIG_BRANCH" ] || FIG_BRANCH=main
	GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
elif [ "$FIG_COMMAND" = 'help' ]; then
	help && exit
elif [ "$FIG_COMMAND" = 'version' ]; then
	echo "$FIG_SELF $FIG_VERSION"
	@GIT@ version
	exit
elif [ x"$FIG_COMMAND" = x'which' ]; then
	[ -z "$2" ] && fatal "$FIG_COMMAND: please specify a filename" 1
	[ -n "$3" ] && fatal "$FIG_COMMAND: too many parameters" 1
	FIG_COMMAND_PARAMETER=$2; export FIG_COMMAND_PARAMETER
elif [ x"$FIG_COMMAND" = x'delete' ]           ||
	[ x"$FIG_COMMAND" = x'enter' ]            ||
	[ x"$FIG_COMMAND" = x'init' ]             ||
	[ x"$FIG_COMMAND" = x'list-tracked-by' ]  ||
	[ x"$FIG_COMMAND" = x'rename' ]           ||
	[ x"$FIG_COMMAND" = x'run' ]              ||
	[ x"$FIG_COMMAND" = x'upgrade' ]          ||
	[ x"$FIG_COMMAND" = x'write-gitignore' ]; then
	if [ -z "$2" ]; then
		[ -z "$FIG_REPO_NAME" ] && fatal "$FIG_COMMAND: please specify repository to work on" 1
	else
		FIG_REPO_NAME=$2; export FIG_REPO_NAME
	fi
	GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
	[ x"$FIG_COMMAND" = x'rename' ] && [ -z "$3" ] && fatal "$FIG_COMMAND: please specify a target name" 1
	[ x"$FIG_COMMAND" = x'run'    ] && [ -z "$3" ] && fatal "$FIG_COMMAND: please specify a command" 1
	[ x"$FIG_COMMAND" = x'rename' ] && { FIG_REPO_NAME_NEW=$3; export FIG_REPO_NAME_NEW;
	GIT_DIR_NEW=$FIG_REPO_D/$FIG_REPO_NAME_NEW.fig/$FIG_REPO_NAME_NEW.git; export GIT_DIR_NEW; }
	[ x"$FIG_COMMAND" = x'run' ]    && shift 2
elif [ x"$FIG_COMMAND" = x'foreach' ]; then
	[ -z "$2" ] && fatal "$FIG_COMMAND: please specify a command" 1
	shift 1
elif [ x"$FIG_COMMAND" = x'add' ] ||
	[ x"$FIG_COMMAND" = x'commit' ] ||
	[ x"$FIG_COMMAND" = x'config' ] ||
	[ x"$FIG_COMMAND" = x'list'   ] ||
	[ x"$FIG_COMMAND" = x'list-tracked' ] ||
	[ x"$FIG_COMMAND" = x'list-untracked' ] ||
	[ x"$FIG_COMMAND" = x'bootstrap' ] ||
	[ x"$FIG_COMMAND" = x'pull'   ] ||
	[ x"$FIG_COMMAND" = x'push'   ] ||
	[ x"$FIG_COMMAND" = x'sync'   ]; then
	:
elif [ x"$FIG_COMMAND" = x'status' ]; then
	if [ x"$2" = x'--terse' ]; then
		FIG_STATUS_TERSE=1; export FIG_STATUS_TERSE
		shift
	fi
	FIG_REPO_NAME=$2; export FIG_REPO_NAME
elif [ -n "$2" ]; then
	FIG_COMMAND='run'; export FIG_COMMAND
	FIG_REPO_NAME=$1; export FIG_REPO_NAME
	GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
	[ -d "$GIT_DIR" ] || { help; exit 1; }
	shift 1
	if [ x"$1" = x'add' ] && auto_add_force "$@"; then
		shift                     # drop "add"
		set -- add -f "$@"        # ...and put it back with -f
	fi
	set -- "@GIT@" "$@"
elif [ -n "$FIG_COMMAND" ]; then
	FIG_COMMAND='enter'; export FIG_COMMAND
	FIG_REPO_NAME=$1; export FIG_REPO_NAME
	GIT_DIR=$FIG_REPO_D/$FIG_REPO_NAME.fig/$FIG_REPO_NAME.git; export GIT_DIR
	[ -d "$GIT_DIR" ] || { help; exit 1; }
else
	# $1 is empty
	help && exit 1
fi

# Did we receive a directory instead of a name?
# Mangle the input to fit normal operation.
if echo "$FIG_REPO_NAME" | @GREP@ -q '/'; then
	GIT_DIR=$FIG_REPO_NAME; export GIT_DIR
	FIG_REPO_NAME=$(basename "$FIG_REPO_NAME" .git); export FIG_REPO_NAME
fi

check_dir() {
	check_directory="$1"
	if [ ! -d "$check_directory" ]; then
		if [ -e "$check_directory" ]; then
			fatal "'$check_directory' exists but is not a directory" 13
		else
			verbose "attempting to create '$check_directory'"
			mkdir -p "$check_directory" || fatal "could not create '$check_directory'" 50
		fi
	fi
}

check_dir "$FIG_REPO_D"

# Seed the shared fallback ignore file so `git add .` in a fig repo is safe
# out of the box (its working tree is all of $HOME). Ignore everything; use
# `fig <repo> add -f <path>` to track a new file, or `fig write-gitignore
# <repo>` for a curated per-repo list.
if [ ! "x$FIG_GITIGNORE" = 'xnone' ] && [ ! -e "$FIG_GITIGNORE_FILE" ]; then
	printf '# fig: ignore everything by default; `fig <repo> add -f <path>` to track a file\n*\n' \
		> "$FIG_GITIGNORE_FILE" 2> /dev/null || true
fi

verbose "$FIG_COMMAND begin"
FIG_COMMAND=$(echo "$FIG_COMMAND" | @SED@ 's/-/_/g'); export FIG_COMMAND

# Source repo-specific rc file, if present: <repo>.fig/.figrc
# shellcheck source=/dev/null
[ -r "$FIG_REPO_D/$FIG_REPO_NAME.fig/.figrc" ] \
	&& . "$FIG_REPO_D/$FIG_REPO_NAME.fig/.figrc"

# source overlay functions
for overlay in "$FIG_OVERLAY_D/$FIG_COMMAND"* "$FIG_OVERLAY_D/$FIG_REPO_NAME.$FIG_COMMAND"*; do
	[ -r "$overlay" ] || continue
	info "sourcing '$overlay'"
	# shellcheck source=/dev/null
	. "$overlay"
done

hook pre-command
$FIG_COMMAND "$@"
hook post-command

verbose "$FIG_COMMAND end, exiting"
exit $FIG_COMMAND_RETURN_CODE

# Local Variables:
# mode:shell-script
# sh-shell:sh
# End:
# vim: ft=sh:
